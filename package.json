{
  "name": "boro-biya",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Boro_biya — safety and relation platform. Phase 1 skeleton: workspace, core API, Relation/SOS service skeletons, Vue web client, gates, and CI.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24 <25",
    "bun": ">=1.4 <1.5"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "gate": "node scripts/gates/run.mjs",
    "docs:gate": "node scripts/gates/phase0.mjs",
    "traceability": "node scripts/gates/traceability.mjs",
    "env:create": "node scripts/env/create.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:db": "node scripts/dev-db.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "format": "node node_modules/prettier/bin/prettier.cjs --check .",
    "format:fix": "node node_modules/prettier/bin/prettier.cjs --write .",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node node_modules/eslint/bin/eslint.js . --fix",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:integration": "node node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "coverage": "node node_modules/vitest/vitest.mjs run --coverage",
    "db:migrate": "node scripts/db/run.mjs init-cluster",
    "db:status": "node scripts/db/run.mjs status",
    "db:rollback": "node scripts/db/run.mjs down --steps 1",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:advisories": "node scripts/check-advisories.mjs",
    "check:telemetry": "node scripts/check-telemetry.mjs",
    "check:images": "node scripts/check-images.mjs",
    "loadtest": "node scripts/loadtest.mjs",
    "start:api": "node apps/api/dist/main.js",
    "start:relation": "node services/relation/dist/main.js",
    "start:sos": "node services/sos/dist/main.js",
    "start:web": "node apps/web/server/serve.mjs"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.4",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "happy-dom": "21.0.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4",
    "vue-eslint-parser": "10.4.1",
    "zopia": "0.7.1"
  },
  "trustedDependencies": [
    "@embedded-postgres/darwin-arm64",
    "@embedded-postgres/darwin-x64",
    "@embedded-postgres/linux-arm",
    "@embedded-postgres/linux-arm64",
    "@embedded-postgres/linux-ia32",
    "@embedded-postgres/linux-ppc64",
    "@embedded-postgres/linux-x64",
    "@embedded-postgres/windows-x64"
  ]
}
