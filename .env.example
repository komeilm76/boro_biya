# Boro_biya — environment template
#
# This file is a template: it contains placeholders only and is safe to commit.
# Copy it locally:      cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
# .env is git-ignored and is never committed, pasted into issues, or shared.
# Production values are injected by the deployment environment or a secret manager.
#
# Values are validated at process start (see docs/development/01-development-environment.md §5).
# Every value below must be replaced before the services will start.
# Every variable is listed with a placeholder and a one-line description (OPS-68).
# Bounds marked "policy decision" are placeholders until the named question in
# docs/DECISIONS.md is answered; the value must then be set to the agreed number.

# ----------------------------------------------------------------- runtime
# Runtime mode; production enables secure cookies, HSTS, and strict error output.
NODE_ENV=<development|test|production>
# Verbosity of structured logs; debug must never be enabled in production.
LOG_LEVEL=<debug|info|warn|error>
# Identity reported in logs, metrics, and health output for this process.
SERVICE_NAME=<api|relation|sos|worker>

# ----------------------------------------------------------------- network
# Interface the HTTP server binds to; 0.0.0.0 is required inside containers.
API_HOST=<0.0.0.0>
# Port the HTTP server listens on.
API_PORT=<3000>
# Origin of the web client, used for redirects and absolute links.
WEB_ORIGIN=<http://localhost:5173>
# Exact origins allowed by CORS; wildcards are rejected in production.
CORS_ALLOWED_ORIGINS=<http://localhost:5173>
# Trust X-Forwarded-* headers; only true behind a reverse proxy you control.
TRUST_PROXY=<false>

# ---------------------------------------------------------------- database
# Local development uses the Docker Compose PostgreSQL instance.
# Connection string for the service's own database/schema owner.
DATABASE_URL=<postgres://boro_biya:password@localhost:5432/boro_biya>
# Database role created by the Compose stack (local development only).
POSTGRES_USER=<boro_biya>
# Password for that role; local development only, never reused elsewhere.
POSTGRES_PASSWORD=<local-development-password>
# Database created by the Compose stack (local development only).
POSTGRES_DB=<boro_biya>
# Maximum pooled connections per service replica.
DB_POOL_MAX=<10>
# Enable the PostGIS extension for indexed proximity queries (ADR-005).
POSTGIS_ENABLED=<false>

# ------------------------------------------------------------------ secrets
# Generate locally with a cryptographically secure random source; never reuse across environments.
# Signs session cookies and server-side session records.
SESSION_SECRET=<generate-a-random-32-byte-value>
# Signs short-lived service-to-service tokens (internal APIs only).
SERVICE_TOKEN_SECRET=<generate-a-random-32-byte-value>
# Signs single-use SSE stream tickets (OPS-25).
STREAM_TICKET_SECRET=<generate-a-random-32-byte-value>

# -------------------------------------------------------- password hashing
# Argon2id parameters, benchmarked for the deployment target (docs/SECURITY.md §2).
# Memory cost per hash in KiB.
ARGON2_MEMORY_KIB=<65536>
# Number of passes over memory.
ARGON2_TIME_COST=<2>
# Parallelism (lanes) per hash.
ARGON2_PARALLELISM=<1>

# ----------------------------------------------------- abuse protection
# Thresholds are policy decisions pending Q-04 (docs/DECISIONS.md).
# Failed logins allowed per account inside the window before lockout.
LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=<10>
# Failed logins allowed per source address inside the window.
LOGIN_MAX_ATTEMPTS_PER_ORIGIN=<30>
# Length of the sliding window for both counters, in seconds.
LOGIN_WINDOW_SECONDS=<900>
# First lockout duration, in seconds; later lockouts escalate.
LOCKOUT_BASE_SECONDS=<60>
# Ceiling for escalated lockouts, in seconds.
LOCKOUT_MAX_SECONDS=<3600>
# Recovery-flow attempts allowed before the challenge is invalidated.
RECOVERY_MAX_ATTEMPTS=<10>
# Default per-user request budget for rate-limited endpoints.
RATE_LIMIT_DEFAULT_PER_MINUTE=<120>

# ------------------------------------------------------------------ captcha
# Provider selection is pending Q-02 (docs/DECISIONS.md).
# Require a CAPTCHA challenge on registration, login, and recovery.
CAPTCHA_ENABLED=<false>
# CAPTCHA implementation in use (never a URL that receives user data silently).
CAPTCHA_PROVIDER=<provider-name>
# Public site/application key handed to the browser.
CAPTCHA_SITE_KEY=<public-site-key>
# Server-side verification key; never exposed to the client.
CAPTCHA_SECRET_KEY=<secret-key>

# ------------------------------------------------------- location sharing
# Bounds for time-boxed, per-follower live sharing (ADR-013) and opt-in location
# history (ADR-014). Numeric limits are policy decisions pending Q-21 and Q-22
# (docs/DECISIONS.md); the per-day share limit is intentionally absent until Q-21
# is answered, so nothing is pre-judged by this template.
# Master switch for live sharing; when false the API refuses to start a share.
LIVE_SHARE_ENABLED=<true>
# Longest single share the owner may request, in seconds.
LIVE_SHARE_MAX_DURATION_SECONDS=<86400>
# Duration preselected in the UI when the owner starts a share, in seconds.
LIVE_SHARE_DEFAULT_DURATION_SECONDS=<3600>
# Maximum number of followers a single share may name.
LIVE_SHARE_MAX_VIEWERS=<25>
# Master switch for retained location history; recording is impossible when false.
LOCATION_HISTORY_ENABLED=<false>
# Default retention window offered to the owner, in days.
LOCATION_HISTORY_DEFAULT_WINDOW_DAYS=<7>
# Longest retention window an owner may choose, in days.
LOCATION_HISTORY_MAX_WINDOW_DAYS=<30>
# Minimum interval between recorded history points, in seconds.
LOCATION_HISTORY_SAMPLE_SECONDS=<60>
# Retention for the last-known (non-live) location row, in hours (pending Q-06).
LAST_KNOWN_LOCATION_TTL_HOURS=<24>

# ---------------------------------------------------------------------- sos
# Dispatch and alert limits. The radius is a policy decision pending Q-07; the
# suggestion window follows SOS-15 (docs/PRODUCT_REQUIREMENTS.md §7).
# Maximum distance from an alert at which users may be suggested, in metres.
SOS_SUGGESTION_RADIUS_METERS=<10000>
# How long a suggestion stays acceptable before it expires, in seconds.
SOS_SUGGESTION_TTL_SECONDS=<900>
# Categories a single alert may carry.
SOS_MAX_CATEGORIES_PER_ALERT=<5>
# Alerts one user may create per hour.
SOS_ALERTS_PER_HOUR=<5>

# --------------------------------------------------------------- uploads
# Largest accepted upload, in bytes.
UPLOAD_MAX_BYTES=<5242880>
# Largest decoded image, in pixels; guards against decompression bombs.
UPLOAD_MAX_PIXELS=<25000000>
# Storage backend for attachments: local filesystem or S3-compatible object store.
UPLOAD_STORAGE_DRIVER=<local|s3>
# Directory used when UPLOAD_STORAGE_DRIVER=local; must not be web-served directly.
UPLOAD_LOCAL_DIR=<./var/uploads>
# S3-compatible endpoint; empty means AWS itself.
S3_ENDPOINT=<https://object-storage.example.invalid>
# Bucket that holds private attachment objects.
S3_BUCKET=<boro-biya-uploads>
# Object-store access key with write access to that bucket only.
S3_ACCESS_KEY_ID=<access-key-id>
# Object-store secret for the same key; never logged.
S3_SECRET_ACCESS_KEY=<secret-access-key>

# ------------------------------------------------------------------- maps
# Provider selection is pending Q-10 (docs/DECISIONS.md). Never ship a key to the browser
# when the provider allows a server-mediated call.
# MapLibre style document describing tiles, layers, and attribution.
MAP_STYLE_URL=<https://tiles.example.invalid/style.json>
# Geocoding/search provider adapter name.
GEOCODING_PROVIDER=<provider-name>
# Server-side key for that provider; never exposed to the browser.
GEOCODING_API_KEY=<provider-key>
# Routing provider adapter name (Phase 6).
ROUTING_PROVIDER=<provider-name>
# Server-side key for the routing provider.
ROUTING_API_KEY=<provider-key>

# --------------------------------------------------------------- realtime
# Interval between SSE keep-alive comments, in seconds.
SSE_HEARTBEAT_SECONDS=<25>
# Concurrent SSE connections allowed per user.
SSE_MAX_CONNECTIONS_PER_USER=<3>
# Lifetime of a single-use stream ticket, in seconds (OPS-25).
STREAM_TICKET_TTL_SECONDS=<30>

# ------------------------------------------------------------ notifications
# Optional integrations; enable only after the provider review in docs/REFERENCES.md.
# Master switch for push notification delivery (pending Q-11).
PUSH_ENABLED=<false>
# Push provider in use.
PUSH_PROVIDER=<provider-name>
# Server-side key for the push provider.
PUSH_SERVER_KEY=<server-key>
# Master switch for outbound email.
SMTP_ENABLED=<false>
# SMTP connection URL used for outbound mail.
SMTP_URL=<smtp://user:password@smtp.example.invalid:587>

# ------------------------------------------------------------------ plugins
# ZIP-driven installation stays disabled until the Phase 7 gate passes (docs/SECURITY.md §6).
# Allow plugin packages to be installed at all.
PLUGIN_INSTALL_ENABLED=<false>
# Directory holding the publisher trust store used for signature checks (SEC-32).
PLUGIN_TRUST_STORE_PATH=<./var/plugin-trust-store>
# Largest accepted plugin archive, in bytes.
PLUGIN_MAX_ARCHIVE_BYTES=<52428800>
# Largest total size a plugin archive may expand to, in bytes.
PLUGIN_MAX_EXTRACTED_BYTES=<209715200>
# Maximum number of entries a plugin archive may contain.
PLUGIN_MAX_FILES=<2000>
