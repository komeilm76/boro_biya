# Boro_biya — environment template
#
# This file is a template: it contains placeholders only and is safe to commit.
# Create local values with `bun run env:create`; do not copy this placeholder template directly.
# .env is git-ignored and is never committed, pasted into issues, or shared.
# No production deployment procedure is verified; this template does not define production configuration.
#
# Backend settings are validated at process start; other Phase 1 values are read by their script, web, or Compose consumer.
# See docs/development/14-environment-and-configuration.md for each consumer, default, and future-phase placeholder.
# `bun run env:create` supplies local development values without activating future features.
# Bounds marked "policy decision" are placeholders until the named question in
# docs/DECISIONS.md is answered; the value must then be set to the agreed number.

# ----------------------------------------------------------------- runtime
# Backend runtime label; Phase 1 validates and logs it but does not enable authentication cookies or HSTS.
NODE_ENV=<development|test|production>
# Verbosity of structured logs; debug must never be enabled in production.
LOG_LEVEL=<debug|info|warn|error>
# Identity reported in logs, metrics, and health output for this process.
SERVICE_NAME=<api|relation|sos>
# Build commit reported by /healthz and structured logs; CI and release builds set it from
# `git rev-parse HEAD` (OPS-61, QA-91).
BUILD_COMMIT=<dev>

# ------------------------------------------------------------- observability
# Interface the metrics server binds to; keep it non-public — the Compose stack never publishes
# the metrics port (OPS-63).
METRICS_HOST=<127.0.0.1>
# Port the metrics server listens on (development defaults: api 9000, relation 9001, sos 9002).
METRICS_PORT=<9000>
# Bounded window to drain in-flight requests on SIGTERM before forcing exit, in seconds (OPS-62).
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=<10>

# ----------------------------------------------------------------- network
# Interface the HTTP server binds to; 0.0.0.0 is required inside containers.
API_HOST=<0.0.0.0>
# Port the HTTP server listens on.
API_PORT=<3000>
# Required and validated for Core API configuration; Phase 1 does not implement auth redirects or business links.
WEB_ORIGIN=<http://localhost:5173>
# Exact origins allowed by CORS; the server configuration rejects wildcards in every environment.
CORS_ALLOWED_ORIGINS=<http://localhost:5173>
# Trust X-Forwarded-* headers; only true behind a reverse proxy you control.
TRUST_PROXY=<false>

# ---------------------------------------------------------------- database
# Local development can use Compose PostgreSQL or the embedded PostgreSQL runner (see developer onboarding).
# Core API connection; the host-run runner and Compose construct Relation/SOS service URLs separately.
DATABASE_URL=<postgres://boro_core:password@localhost:5432/boro_biya>
# Database role created by the Compose stack (local development only).
POSTGRES_USER=<boro_biya>
# Password for that role; local development only, never reused elsewhere.
POSTGRES_PASSWORD=<local-development-password>
# Database created by the Compose stack (local development only).
POSTGRES_DB=<boro_biya>
# Maximum pooled connections per service replica.
DB_POOL_MAX=<10>
# Connection timeout per pool acquisition, in milliseconds (OPS-48).
DB_CONNECT_TIMEOUT_MS=<2000>
# Statement timeout applied to pooled queries, in milliseconds (OPS-48).
DB_STATEMENT_TIMEOUT_MS=<5000>
# Host port PostgreSQL publishes on 127.0.0.1 for host-run development tools; change if busy (OPS-67).
DB_PORT=<5432>
# Enable the PostGIS extension for indexed proximity queries (ADR-005).
POSTGIS_ENABLED=<false>

# ------------------------------------------------------- database operations
# Administrative connection used ONLY by the migration runner (bun run db:migrate, the Compose
# migrate job); services never run with it — each connects as its own least-privilege role
# (OPS-17, OPS-18).
DB_ADMIN_URL=<postgres://boro_biya:local-development-password@localhost:5432/boro_biya>
# Passwords of the per-service roles created by the cluster bootstrap. `bun run env:create`
# generates local values; no production deployment or secret-injection procedure is verified.
CORE_DB_PASSWORD=<local-development-password>
RELATION_DB_PASSWORD=<local-development-password>
SOS_DB_PASSWORD=<local-development-password>

# ------------------------------------------------------------------ secrets
# Generate locally with a cryptographically secure random source; never reuse across environments.
# Signs access tokens, refresh tokens, and the refresh cookie (ADR-021).
SESSION_SECRET=<generate-a-random-32-byte-value>
# Access-token lifetime, in seconds. Short by design: a stateless token cannot be revoked
# before it expires ([ADR-021](docs/DECISIONS.md)).
ACCESS_TOKEN_TTL_SECONDS=<900>
# Refresh-token family lifetime, in days; every use rotates the token (ADR-021).
REFRESH_TOKEN_TTL_DAYS=<30>
# Signs short-lived service-to-service tokens (internal APIs only).
SERVICE_TOKEN_SECRET=<generate-a-random-32-byte-value>
# Signs single-use SSE stream tickets (OPS-25).
STREAM_TICKET_SECRET=<generate-a-random-32-byte-value>

# -------------------------------------------------------- password hashing
# Argon2id parameters, benchmarked for the deployment target (docs/SECURITY.md §2).
# Memory cost per hash in KiB.
ARGON2_MEMORY_KIB=<65536>
# Number of passes over memory.
ARGON2_TIME_COST=<2>
# Parallelism (lanes) per hash.
ARGON2_PARALLELISM=<1>

# ----------------------------------------------------- abuse protection
# Thresholds follow the abuse-protection policy of ADR-022 (docs/DECISIONS.md): 10 failed
# attempts per account in a 15-minute window, progressive delays, and a 15-minute lockout
# that expires on its own. Development values are relaxed; the production set is reviewed
# before release and every value here is configuration, not code.
# Failed logins allowed per account inside the window before lockout.
LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=<10>
# Failed logins allowed per source address inside the window.
LOGIN_MAX_ATTEMPTS_PER_ORIGIN=<30>
# Length of the sliding window for both counters, in seconds.
LOGIN_WINDOW_SECONDS=<900>
# Lockout duration applied at the threshold, in seconds; it expires on its own (ADR-022).
LOCKOUT_SECONDS=<900>
# Ceiling for the progressive delay added after repeated failures, in seconds.
LOGIN_DELAY_MAX_SECONDS=<30>
# Automated permanent bans are disabled by default and, when enabled, follow the documented
# review policy of SEC-17 (ADR-022).
AUTOMATED_BAN_ENABLED=<false>
# Recovery-flow attempts allowed before the challenge is invalidated.
RECOVERY_MAX_ATTEMPTS=<10>
# Recovery challenge and reset-grant lifetimes in seconds (each bounded to 900).
RECOVERY_CHALLENGE_TTL_SECONDS=<300>
RECOVERY_GRANT_TTL_SECONDS=<300>
# Default per-user request budget for rate-limited endpoints.
RATE_LIMIT_DEFAULT_PER_MINUTE=<120>

# ------------------------------------------------------------------ captcha
# Self-hosted, privacy-first challenge (ADR-020, docs/DECISIONS.md): adaptive difficulty from
# the risk policy, server-side token validation, no third-party service, no client tracker.
# Enable self-hosted computational work for risky registration, login, recovery and setup.
CAPTCHA_ENABLED=<false>
# Difficulty follows the configured risk policy rather than a fixed level.
CAPTCHA_ADAPTIVE=<true>
# SHA-256 leading zero bits, 12–20; adaptive work is capped at 20.
CAPTCHA_WORK_BITS=<14>
# Prior attempts per keyed origin/purpose in LOGIN_WINDOW_SECONDS before work is required, 1–30.
CAPTCHA_RISK_THRESHOLD=<3>
# Challenge lifetime, in seconds; an expired challenge is rejected, never revalidated.
CAPTCHA_CHALLENGE_TTL_SECONDS=<300>
# Validation attempts allowed per challenge before it is invalidated.
CAPTCHA_MAX_ATTEMPTS=<5>
# HMAC key for stored nonce/grant/origin digests, at least 32 bytes; never leaves the server.
CAPTCHA_TOKEN_SECRET=<generate-a-random-32-byte-value>
# Self-service recovery switch (ADR-023). When false, recovery endpoints reject attempts
# securely and the UI warns before an account is relied on.
SECURITY_QUESTIONS_ENABLED=<true>

# ------------------------------------------------------- location sharing
# Bounds for time-boxed, per-follower live sharing (ADR-013) and opt-in location
# history (ADR-014). Numeric limits are policy decisions pending Q-21 and Q-22
# (docs/DECISIONS.md); the per-day share limit is intentionally absent until Q-21
# is answered, so nothing is pre-judged by this template.
# Master switch for live sharing; when false the API refuses to start a share.
LIVE_SHARE_ENABLED=<true>
# Longest single share the owner may request, in seconds.
LIVE_SHARE_MAX_DURATION_SECONDS=<86400>
# Duration preselected in the UI when the owner starts a share, in seconds.
LIVE_SHARE_DEFAULT_DURATION_SECONDS=<3600>
# Maximum number of followers a single share may name.
LIVE_SHARE_MAX_VIEWERS=<25>
# Master switch for retained location history; recording is impossible when false.
LOCATION_HISTORY_ENABLED=<false>
# Default retention window offered to the owner, in days.
LOCATION_HISTORY_DEFAULT_WINDOW_DAYS=<7>
# Longest retention window an owner may choose, in days.
LOCATION_HISTORY_MAX_WINDOW_DAYS=<30>
# Minimum interval between recorded history points, in seconds.
LOCATION_HISTORY_SAMPLE_SECONDS=<60>
# Retention for the last-known (non-live) location row, in hours (pending Q-06).
LAST_KNOWN_LOCATION_TTL_HOURS=<24>

# ---------------------------------------------------------------------- sos
# Dispatch and alert limits. The radius is a policy decision pending Q-07; the
# suggestion window follows SOS-15 (docs/PRODUCT_REQUIREMENTS.md §7).
# Maximum distance from an alert at which users may be suggested, in metres.
SOS_SUGGESTION_RADIUS_METERS=<10000>
# How long a suggestion stays acceptable before it expires, in seconds.
SOS_SUGGESTION_TTL_SECONDS=<900>
# Categories a single alert may carry.
SOS_MAX_CATEGORIES_PER_ALERT=<5>
# Alerts one user may create per hour.
SOS_ALERTS_PER_HOUR=<5>

# --------------------------------------------------------------- uploads
# Largest accepted upload, in bytes.
UPLOAD_MAX_BYTES=<5242880>
# Largest decoded image, in pixels; guards against decompression bombs.
UPLOAD_MAX_PIXELS=<25000000>
# Storage backend for attachments: local filesystem or S3-compatible object store.
UPLOAD_STORAGE_DRIVER=<local|s3>
# Directory used when UPLOAD_STORAGE_DRIVER=local; must not be web-served directly.
UPLOAD_LOCAL_DIR=<./var/uploads>
# S3-compatible endpoint; empty means AWS itself.
S3_ENDPOINT=<https://object-storage.example.invalid>
# Bucket that holds private attachment objects.
S3_BUCKET=<boro-biya-uploads>
# Object-store access key with write access to that bucket only.
S3_ACCESS_KEY_ID=<access-key-id>
# Object-store secret for the same key; never logged.
S3_SECRET_ACCESS_KEY=<secret-access-key>

# ------------------------------------------------------------------- maps
# Provider selection is pending Q-10 (docs/DECISIONS.md). Never ship a key to the browser
# when the provider allows a server-mediated call.
# MapLibre style document describing tiles, layers, and attribution.
MAP_STYLE_URL=<https://tiles.example.invalid/style.json>
# Geocoding/search provider adapter name.
GEOCODING_PROVIDER=<provider-name>
# Server-side key for that provider; never exposed to the browser.
GEOCODING_API_KEY=<provider-key>
# Routing provider adapter name (Phase 6).
ROUTING_PROVIDER=<provider-name>
# Server-side key for the routing provider.
ROUTING_API_KEY=<provider-key>

# --------------------------------------------------------------- realtime
# Interval between SSE keep-alive comments, in seconds.
SSE_HEARTBEAT_SECONDS=<25>
# Concurrent SSE connections allowed per user.
SSE_MAX_CONNECTIONS_PER_USER=<3>
# Lifetime of a single-use stream ticket, in seconds (OPS-25).
STREAM_TICKET_TTL_SECONDS=<30>

# ------------------------------------------------------------ notifications
# Optional integrations; enable only after the provider review in docs/REFERENCES.md.
# Master switch for push notification delivery (pending Q-11).
PUSH_ENABLED=<false>
# Push provider in use.
PUSH_PROVIDER=<provider-name>
# Server-side key for the push provider.
PUSH_SERVER_KEY=<server-key>
# No email and no SMS channel exists: the product stores no email address and no mobile number
# (ADR-019, docs/DECISIONS.md), so there is nothing to configure here. A contact channel needs
# a new owner decision before any provider is added.

# ------------------------------------------------- retention and deletion
# Automated deletion is DISABLED by default (ADR-026, docs/DECISIONS.md): with this false,
# no scheduled job deletes user data, audit records, or operational records, and the
# deployment keeps everything until its operator approves a policy (OPS-85).
RETENTION_AUTOMATED_DELETION_ENABLED=<false>
# Audit-log retention window, in days, applied only when automated deletion is enabled and
# the deployment's audit policy is approved. 0 means "keep on schedule; never delete".
AUDIT_LOG_RETENTION_DAYS=<0>
# Operational-record retention window, in days (logs, metrics, job and idempotency records),
# under the same rule.
OPERATIONAL_RECORD_RETENTION_DAYS=<0>
# Path to the filled-in deployment profile: operating organization, applicable jurisdictions,
# data residency, and the policies approved for this deployment (OPS-85, ADR-027).
DEPLOYMENT_PROFILE_PATH=<./deployment/profile.md>

# -------------------------------------------------------- independent services
# No application package/ZIP installer exists (ADR-030). Configure each service's
# DATABASE_URL and validated listener/metrics variables in its deployment environment.
# SERVICE_DB_PASSWORD is only for the selected-service migration deployment job;
# never inject DB_ADMIN_URL or that password into a runtime service.

# ------------------------------------------------------------ development ports
# API, relation, and SOS listen on these ports only in the host-run `bun run dev` stack; Compose
# keeps those service ports private on its Docker network. API_PORT lives in the network section.
RELATION_PORT=<3001>
SOS_PORT=<3002>
# Host port for the web edge in Compose (loopback-only unless WEB_PUBLISH_ADDRESS is changed).
WEB_PORT=<8080>
# Optional host interface for the Compose web edge. Keep 127.0.0.1 unless an operator explicitly
# configures a wider bind and supplies the required firewall/TLS/reverse-proxy controls.
WEB_PUBLISH_ADDRESS=<127.0.0.1>

# ------------------------------------------------------------------ web edge
# Directory holding the built web artefact served by the Node static server (OPS-01).
WEB_STATIC_DIR=<./apps/web/dist>
# Interface the static server binds to; loopback by default, containers set 0.0.0.0 (OPS-70).
WEB_HOST=<127.0.0.1>
# Fixed upstream the static server proxies /api/* to; never user input, so SSRF is closed by
# construction (SEC-48, OPS-64).
API_ORIGIN=<http://localhost:3000>
# Proxy timeout for upstream API requests, in milliseconds (API-15, OPS-48).
SERVE_PROXY_TIMEOUT_MS=<30000>

# ----------------------------------------------------------------- web build
# API base baked into the web bundle at build time: empty means same-origin relative paths, so
# browser code never names a backend host (OPS-64, GOV-90).
VITE_API_BASE=<same-origin>
# Default catalogue locale; English by owner decision, never inferred from headers or geo-IP
# (ADR-018).
VITE_DEFAULT_LOCALE=<en>
